<Window x:Class="Challenge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Challenge"
        mc:Ignorable="d"
        Name="CurrencyConversionWindow"
        Title="Currency Converter"
        Width="860" MinWidth="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/AppIcon.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <!-- The window sizes its height to this content, so it shrinks when the history card is hidden. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Conversion card ===== -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>

                <!-- Amount, From, swap, To -->
                <Grid Name="CurrencyPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Amount" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Name="SourceCurrencyTextBox"
                             Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="From" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox Grid.Row="1" Grid.Column="2" Name="SourceCurrencyComboBox"
                              ItemsSource="{Binding Currencies}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedSourceCurrency, ValidatesOnDataErrors=True}"/>

                    <Button Grid.Row="1" Grid.Column="4" Name="SwapCurrenciesButton" Width="38" Padding="0"
                            Command="{Binding SwapCurrenciesCommand}"
                            ToolTip="Swap currencies" AutomationProperties.Name="Swap currencies">
                        <TextBlock Text="&#xE8AB;" Style="{StaticResource IconStyle}"/>
                    </Button>

                    <TextBlock Grid.Row="0" Grid.Column="6" Text="To" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox Grid.Row="1" Grid.Column="6" Name="TargetCurrencyComboBox"
                              ItemsSource="{Binding Currencies}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedTargetCurrency, ValidatesOnDataErrors=True}"/>
                </Grid>

                <!-- Time frame -->
                <Grid Name="TimeRangePanel" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Period from" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker Grid.Row="1" Grid.Column="0" Name="StartDatePicker"
                                SelectedDate="{Binding StartDate, ValidatesOnDataErrors=True}"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Period to" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker Grid.Row="1" Grid.Column="2" Name="EndDatePicker"
                                SelectedDate="{Binding EndDate, ValidatesOnDataErrors=True}"/>
                </Grid>

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20,0,16"/>

                <!-- Result and actions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Name="ResultPanel" VerticalAlignment="Bottom">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <!-- Nothing to show while loading or while the input is invalid. -->
                                    <DataTrigger Binding="{Binding LatestAmountText}" Value="">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Name="LatestAmountTextBlock">
                            <Run Text="{Binding LatestAmountText, Mode=OneWay}" FontSize="34" FontWeight="SemiBold"/>
                            <Run Text="{Binding SelectedTargetCurrency.Code, Mode=OneWay}" FontSize="18"
                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                        </TextBlock>
                        <TextBlock Name="LatestDateTextBlock" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="{Binding LatestRateText, Mode=OneWay}"/>
                            <Run Text="·"/>
                            <Run Text="{Binding LatestDateText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Name="ToggleHistoryButton"
                                Content="{Binding HistoryButtonText}" Command="{Binding ToggleHistoryCommand}"/>
                        <Button Name="RefreshButton" Margin="8,0,0,0" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource IconStyle}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Loading, validation and service messages -->
                <Border Name="StatusPanel" Style="{StaticResource StatusBannerStyle}" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar Width="60" Height="6" Margin="0,0,10,0" IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusTextStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== Historical data card ===== -->
        <Border Grid.Row="1" Name="HistoryCard" Style="{StaticResource CardStyle}" Padding="0" Margin="0,16,0,0"
                Visibility="{Binding IsHistoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Historical data" Style="{StaticResource SectionTitleStyle}"
                           Margin="20,16,20,8"/>
                <!-- Fixed height: the list scrolls instead of stretching the window to fit every day. -->
                <ListView Name="HistoricRatesListView" Margin="8,0,8,8" Height="320"
                          BorderThickness="0" Background="Transparent"
                          ItemsSource="{Binding HistoricRates}"
                          AlternationCount="2" ItemContainerStyle="{StaticResource HistoryRowStyle}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource HistoryHeaderStyle}">
                            <GridViewColumn Header="Date" Width="200"
                                            DisplayMemberBinding="{Binding Date, StringFormat={}{0:d}}"/>
                            <GridViewColumn Width="220">
                                <GridViewColumn.Header>
                                    <TextBlock Text="Converted amount" Width="208" TextAlignment="Right"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Value, StringFormat='{}{0:#,##0.00##}'}" TextAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="120">
                                <GridViewColumn.Header>
                                    <TextBlock Text="Currency" Width="108" TextAlignment="Right"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Currency}" TextAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</Window>
