<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="Cache.EvictionStrategy" value="TimeBased" />
    <add key="Cache.MaxAgeMinutes" value="10" />
    <add key="Cache.MaxElements" value="20" />
    <!-- Debug, Info, Warning or Error. Logs go to %LOCALAPPDATA%\CurrencyConverter\Logs. -->
    <add key="Logging.MinimumLevel" value="Info" />
  </appSettings>
</configuration>
